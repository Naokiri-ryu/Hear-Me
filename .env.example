DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hear_me
REDIS_URL=redis://localhost:6379/0

# environment: development | production
ENV=development

# JWT signing key (HS256). Generate unik dan >= 32 byte:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Fernet key untuk enkripsi token platform di DB (platform_credentials).
# WAJIB TERPISAH dari SECRET_KEY — jangan pakai key yang sama. Generate terpisah:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Spotify app (developer.spotify.com) — kosongkan kalau belum diganti
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/spotify/callback

# MusicBrainz (open metadata, no key; wajib User-Agent + min 1 req/s)
MUSICBRAINZ_API_BASE=https://musicbrainz.org/ws/2
MUSICBRAINZ_REQUEST_INTERVAL_SECONDS=1.0